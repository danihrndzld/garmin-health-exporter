{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Garmin Export",
  "version": "4.2.0",
  "identifier": "dev.danihrndzld.garmin-export",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "bun run sidecar",
    "beforeBuildCommand": "bun run sidecar"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Garmin Export",
        "width": 1000,
        "height": 720,
        "minWidth": 860,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "HealthcareAndFitness",
    "externalBin": [
      "binaries/garmin-core",
      "binaries/garmin-export-core"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
